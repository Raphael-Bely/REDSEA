# Copier ce fichier en .env (jamais versionné) et renseigner les valeurs.
# En production, définir ces variables dans l'interface de l'hébergeur (Vercel > Settings > Environment Variables).

# URL publique du site, sans slash final (canonical, Open Graph, sitemap). Lue au build.
SITE_URL=https://redsea.example

# --- Resend (envoi de l'email de devis) ---
RESEND_API_KEY=
# Adresse qui reçoit les demandes de devis (jamais exposée côté client).
QUOTE_RECIPIENT_EMAIL=
# Expéditeur. Tant qu'aucun domaine n'est vérifié chez Resend, garder onboarding@resend.dev.
# Ensuite : QUOTE_SENDER_EMAIL="REDSEA Devis <devis@mondomaine.fr>"
QUOTE_SENDER_EMAIL="REDSEA Devis <onboarding@resend.dev>"

# --- Slack (optionnel) : Incoming Webhook. Laisser vide pour désactiver. ---
SLACK_WEBHOOK_URL=

# --- Cloudflare Turnstile (anti-robot sans cookie) ---
# Clé publique (affichée dans le HTML, c'est normal) et clé secrète (serveur uniquement).
# Clés de test Cloudflare qui valident toujours : 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
